{
  "name": "ngx-helper",
  "version": "21.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run cpassets && ng serve",
    "cpassets": "cp -R projects/smallpearl/ngx-helper/src/assets/* ./src/assets",
    "lib:bump-build": "cd projects/smallpearl/ngx-helper && standard-version --infile ../../../CHANGELOG.md && cp README.md ../../.. && cd ../../.. && ng build @smallpearl/ngx-helper",
    "lib:release": "npm run lib:test && cd projects/smallpearl/ngx-helper && standard-version --infile ../../../CHANGELOG.md && cp README.md ../../.. && cd ../../.. && ng build @smallpearl/ngx-helper && cd dist/smallpearl/ngx-helper && npm publish --access=public",
    "lib:build": "ng build @smallpearl/ngx-helper",
    "lib:watch": "ng build @smallpearl/ngx-helper --configuration development --watch",
    "lib:test": "ng test @smallpearl/ngx-helper",
    "lib:test-rel": "ng test @smallpearl/ngx-helper",
    "publish": "cd dist/smallpearl/ngx-helper && npm publish --access=public"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.1.2",
    "@angular/cdk": "^21.1.3",
    "@angular/common": "21.1.2",
    "@angular/compiler": "21.1.2",
    "@angular/core": "21.1.2",
    "@angular/forms": "21.1.2",
    "@angular/material": "^21.1.3",
    "@angular/platform-browser": "21.1.2",
    "@angular/platform-browser-dynamic": "21.1.2",
    "@angular/router": "21.1.2",
    "@jsverse/transloco": "^7.5.1",
    "@ngneat/elf": "^2.5.1",
    "@ngneat/elf-entities": "^5.0.2",
    "@ngneat/elf-pagination": "^1.1.0",
    "@ngneat/error-tailor": "^5.0.1",
    "angular-split": "^20.0.0",
    "google-libphonenumber": "^3.2.34",
    "lodash-es": "^4.17.23",
    "ngx-infinite-scroll": "^21.0.0",
    "ngx-mat-select-search": "^8.0.4",
    "pluralize": "^8.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.2.3",
    "@analogjs/vite-plugin-angular": "^2.2.3",
    "@analogjs/vitest-angular": "^2.2.3",
    "@angular-devkit/core": "21.1.2",
    "@angular-devkit/schematics": "21.1.2",
    "@angular/build": "^21.1.2",
    "@angular/cli": "21.1.2",
    "@angular/compiler-cli": "21.1.2",
    "@angular/language-service": "21.1.2",
    "@jsverse/transloco-scoped-libs": "^7.0.1",
    "@ngneat/spectator": "^22.1.0",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/jasmine": "~5.1.0",
    "@types/lodash-es": "^4.17.12",
    "@types/pluralize": "^0.0.33",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.1.0",
    "standard-version": "^9.5.0",
    "typescript": "~5.9.3",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  }
}
